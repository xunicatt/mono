CompileFlags:
  Add: [
    -ffreestanding,
    -Wall,
    -Werror,
    -Wextra,
  ]
  Remove: [
    -mstm8,
    --opt-code-size,
    --disable-warning,
    --Werror,
  ]
  Compiler: sdcc
